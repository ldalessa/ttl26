{
    "version": 3,
    "configurePresets": [
        {
            "name": "ninja",
            "hidden": true,
            "generator": "Ninja",
            "environment": {
                "CFLAGS": "-fdiagnostics-color=always",
                "CXXFLAGS": "-fdiagnostics-color=always"
            }
        },
        {
            "name": "libcxx-toolchain",
            "hidden": true,
						"toolchainFile": ".cmake/libc++.cmake"
        },
        {
            "name": "clangd",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": true
                }
            }
        },
        {
            "name": "lto",
            "inherits": ["libcxx-toolchain", "ninja"],
            "binaryDir": "${sourceDir}/build/timing",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "lto"
                },
                "CMAKE_CXX_FLAGS_LTO": {
                    "type": "STRING",
                    "value": "-O3 -DNDEBUG -flto=auto"
                }
            }
        },
	    {
            "name": "release",
            "inherits": ["libcxx-toolchain", "ninja"],
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "Release"
                },
                "CMAKE_CXX_FLAGS_RELEASE": {
                    "type": "STRING",
                    "value": "-O3"
                }
            }
        },
        {
            "name": "og",
            "inherits": ["libcxx-toolchain", "ninja"],
            "binaryDir": "${sourceDir}/build/og",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "Og"
                },
                "CMAKE_CXX_FLAGS_OG": {
                    "type": "STRING",
                    "value": "-Og -g"
                }
            }
        },
        {
            "name": "debug",
            "inherits": ["libcxx-toolchain", "ninja"],
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "Debug"
                },
                "CMAKE_CXX_FLAGS_DEBUG": {
                    "type": "STRING",
                    "value": "-O0 -g"
                }
            }
        },
        {
            "name": "asan",
            "inherits": ["debug"],
            "binaryDir": "${sourceDir}/build/asan",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_DEBUG": {
                    "type": "STRING",
                    "value": "-O0 -g -fsanitize=address,undefined"
                }
            }
        },
        {
            "name": "asan-og",
            "inherits": ["og"],
            "binaryDir": "${sourceDir}/build/asan-og",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_OG": {
                    "type": "STRING",
                    "value": "-Og -g -fsanitize=address,undefined"
                }
            }
        },
        {
            "name": "tidy",
            "inherits": ["debug","clangd"],
            "binaryDir": "${sourceDir}/build/tidy",
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": {
                    "type": "STRING",
                    "value": "clang-tidy;-checks=-*,clang-analyzer-*"
                }
            }
        }
    ]
}
